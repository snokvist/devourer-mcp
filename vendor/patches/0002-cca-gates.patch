diff --git a/vendor/devourer/src/IRtlRadio.h b/vendor/devourer/src/IRtlRadio.h
index a3f0794..739ac93 100644
--- a/vendor/devourer/src/IRtlRadio.h
+++ b/vendor/devourer/src/IRtlRadio.h
@@ -85,6 +85,33 @@ public:
    * tests/canary_diff.py. Reading a powered-down chip yields garbage or throws;
    * interpreting that is the caller's job. No-op where unsupported (default). */
   virtual void DumpChipState() {}
+
+  /* The carrier-sense gate, one bit at a time.
+   *
+   * SetCcaMode is all-or-nothing, and on this family it is two gates:
+   * 0x520[14] primary CCA (defers to a decodable preamble) and 0x520[15]
+   * EDCCA (defers to raw in-band energy). They answer different questions
+   * and devourer's own on-air work found they behave very differently —
+   * tests/dis_cca_tx_onair.sh measured primary CCA costing a Jaguar3
+   * injector 41-45% against a co-channel flooder while the energy bit alone
+   * was null. A caller that only needs one of them should not have to turn
+   * off both, and a caller diagnosing a deferral needs to tell them apart.
+   *
+   * `true` means DISABLED, matching SetCcaMode's argument sense and the
+   * register's own polarity (the bit set = gate off). Returns false where
+   * the split is not ported; SetCcaMode remains the portable call. */
+  virtual bool SetCcaGates(bool primary_disabled, bool edcca_disabled) {
+    (void)primary_disabled;
+    (void)edcca_disabled;
+    return false;
+  }
+
+  /* Current gate state, read back from the hardware rather than remembered. */
+  virtual bool GetCcaGates(bool &primary_disabled, bool &edcca_disabled) {
+    (void)primary_disabled;
+    (void)edcca_disabled;
+    return false;
+  }
 };
 
 #endif /* IRTL_RADIO_H */
